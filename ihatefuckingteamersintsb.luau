local WindUI = loadstring(game:HttpGet(
    "https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"
))()

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

local selectedTargetName = nil
local comboRunning = false
local comboSession = 0

local orbitConnection = nil
local angle = 0
local controlledHumanoid = nil
local previousPlatformStand = false

local comboToggle = nil
local suppressToggleCallback = false

local ORBIT_RADIUS = 3
local ORBIT_HEIGHT = -3.2 -- below the target's HumanoidRootPart / near feet
local ORBIT_SPEED = 4
local M1_DELAY = 0.1
local ROUND_DELAY = 0.2

local stopCombo

local function getCharacter(targetPlayer)
    return targetPlayer and targetPlayer.Character
end

local function getHumanoid(targetPlayer)
    local character = getCharacter(targetPlayer)

    if not character then
        return nil
    end

    return character:FindFirstChildOfClass("Humanoid")
end

local function getRoot(targetPlayer)
    local character = getCharacter(targetPlayer)

    if not character then
        return nil
    end

    return character:FindFirstChild("HumanoidRootPart")
end

local function isAlive(targetPlayer)
    local humanoid = getHumanoid(targetPlayer)
    local root = getRoot(targetPlayer)

    return humanoid ~= nil and humanoid.Health > 0 and root ~= nil
end

local function getRemote()
    local character = player.Character

    if not character then
        return nil
    end

    return character:FindFirstChild("Communicate")
end

local function getToolNames()
    local backpack = player:FindFirstChild("Backpack")

    if not backpack then
        return {}
    end

    local toolNames = {}

    for _, item in ipairs(backpack:GetChildren()) do
        if item:IsA("Tool") then
            table.insert(toolNames, item.Name)
        end
    end

    return toolNames
end

local function findTool(toolName)
    local backpack = player:FindFirstChild("Backpack")
    local character = player.Character

    local tool = backpack and backpack:FindFirstChild(toolName)

    if not tool and character then
        tool = character:FindFirstChild(toolName)
    end

    if tool and tool:IsA("Tool") then
        return tool
    end

    return nil
end

local function stopOrbit()
    if orbitConnection then
        orbitConnection:Disconnect()
        orbitConnection = nil
    end

    if controlledHumanoid and controlledHumanoid.Parent then
        controlledHumanoid.PlatformStand = previousPlatformStand
    end

    controlledHumanoid = nil
end

local function isCurrentSession(session, target)
    return comboRunning
        and comboSession == session
        and target
        and Players:FindFirstChild(target.Name) == target
        and isAlive(player)
        and isAlive(target)
end

local function startOrbit(target, session)
    stopOrbit()

    local myHumanoid = getHumanoid(player)

    if myHumanoid then
        controlledHumanoid = myHumanoid
        previousPlatformStand = myHumanoid.PlatformStand
        myHumanoid.PlatformStand = true
    end

    orbitConnection = RunService.Heartbeat:Connect(function(deltaTime)
        if not isCurrentSession(session, target) then
            stopCombo()
            return
        end

        local targetRoot = getRoot(target)
        local myRoot = getRoot(player)

        if not targetRoot or not myRoot then
            stopCombo()
            return
        end

        angle = angle + ORBIT_SPEED * deltaTime

        local position = targetRoot.Position + Vector3.new(
            math.cos(angle) * ORBIT_RADIUS,
            ORBIT_HEIGHT,
            math.sin(angle) * ORBIT_RADIUS
        )

        -- Faces the target even while orbiting below them.
        myRoot.CFrame = CFrame.lookAt(position, targetRoot.Position)
    end)
end

local function doM1(session, target)
    for _ = 1, 3 do
        if not isCurrentSession(session, target) then
            return false
        end

        local remote = getRemote()

        if remote then
            remote:FireServer({
                Mobile = true,
                Goal = "LeftClick",
            })

            remote:FireServer({
                Mobile = true,
                Goal = "LeftClickRelease",
            })
        end

        task.wait(M1_DELAY)
    end

    return true
end

local function fireMove(toolName, session, target)
    if not isCurrentSession(session, target) then
        return false
    end

    local remote = getRemote()
    local tool = findTool(toolName)

    if not remote or not tool then
        return false
    end

    remote:FireServer({
        IsAutoActivate = true,
        Goal = "Console Move",
        Tool = tool,
        ToolName = toolName,
    })

    return true
end

local function doComboRound(session, target)
    local toolNames = getToolNames()
    local toolCount = math.min(#toolNames, 4)

    if toolCount == 0 then
        return
    end

    for index = 1, toolCount do
        if not doM1(session, target) then
            return
        end

        if not fireMove(toolNames[index], session, target) then
            return
        end

        task.wait(M1_DELAY)
    end
end

local function stopCombo()
    comboEnabled = false
    comboSession = comboSession + 1
    stopOrbit()
end

local function startCombo()
    comboEnabled = true
    comboSession = comboSession + 1

    local session = comboSession

    task.spawn(function()
        while comboEnabled and comboSession == session do
            local target = getSelectedTarget()

            if target and isAlive(player) and isAlive(target) then
                startOrbit(target, session)
                doComboRound(session, target)
                task.wait(TIME_BETWEEN_ROUNDS)
            else
                -- Target is dead/missing: pause only.
                -- Do NOT call stopCombo here.
                stopOrbit()
                task.wait(PAUSE_CHECK_DELAY)
            end
        end

        stopOrbit()
    end)
end

local function getPlayerNames()
    local names = {}

    for _, otherPlayer in ipairs(Players:GetPlayers()) do
        if otherPlayer ~= player then
            table.insert(names, otherPlayer.Name)
        end
    end

    table.sort(names)

    return names
end

local Window = WindUI:CreateWindow({
    Title = "Combat Test",
    Icon = "crosshair",
    Author = "Local test controls",
    Folder = "CombatTest",
    Size = UDim2.fromOffset(460, 300),
    MinSize = Vector2.new(420, 260),
    Theme = "Dark",
    Transparent = true,
    Resizable = false,
    ToggleKey = Enum.KeyCode.RightShift,
})

local Tab = Window:Tab({
    Title = "Target",
    Icon = "crosshair",
})

local initialNames = getPlayerNames()

local targetDropdown = Tab:Dropdown({
    Title = "Target player",
    Desc = "Uses player usernames, not display names.",
    Values = initialNames,
    Value = initialNames[1],
    Multi = false,
    AllowNone = true,
    Callback = function(name)
        if selectedTargetName ~= name then
            stopCombo()
        end

        selectedTargetName = name
    end,
})

if initialNames[1] then
    selectedTargetName = initialNames[1]
end

Tab:Button({
    Title = "Refresh players",
    Desc = "Update the username list.",
    Callback = function()
        local names = getPlayerNames()

        targetDropdown:Refresh(names)

        if selectedTargetName and not Players:FindFirstChild(selectedTargetName) then
            selectedTargetName = nil
        end
    end,
})

comboToggle = Tab:Toggle({
    Title = "Combo attack",
    Value = false,
    Callback = function(enabled)
        if enabled then
            startCombo()
        else
            stopCombo()
        end
    end,
})

player.CharacterAdded:Connect(function()
    -- Do not resume automatically after a death/respawn.
    stopCombo()
end)

Players.PlayerRemoving:Connect(function(leavingPlayer)
    if leavingPlayer.Name == selectedTargetName then
        selectedTargetName = nil
        stopCombo()
    end
end)

Tab:Select()
