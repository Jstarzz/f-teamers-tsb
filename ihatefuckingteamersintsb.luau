local function get_moves()
    local moves = {}
    local tools = backpack:GetChildren()
    for _, tool in tools do
        table.insert(moves, tool.Name)
    end
    return moves
end

local function m1()
    for i = 1, 3 do
        if remote then
            remote:FireServer({
                Mobile = true,
                Goal = "LeftClick",
            })

            remote:FireServer({
                Goal = "LeftClickRelease",
                Mobile = true,
            })
        end
        task.wait(0.1)
    end
end

local function find_target(name)
    local target = game:GetService("Players"):FindFirstChild(name)
    return target
end

local RunService = game:GetService("RunService")
local orbitConnection = nil
local angle = 0
print("works")
local function orbit(target, flag, radius, speed)
    radius = radius or 3
    speed = speed or 3

    if flag == false or flag == "stop" then
        if orbitConnection then
            orbitConnection:Disconnect()
            orbitConnection = nil
        end
        return
    end

    if orbitConnection or not target or not target.Character then return end
    
    local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
    local myCharacter = player.Character
    local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
    local humanoid = myCharacter and myCharacter:FindFirstChildOfClass("Humanoid")
    
    if not targetRoot or not myRoot then return end
    if humanoid then humanoid.PlatformStand = true end

    orbitConnection = RunService.Heartbeat:Connect(function(deltaTime)
        if not targetRoot.Parent or not myRoot.Parent then
            if orbitConnection then orbitConnection:Disconnect() orbitConnection = nil end
            if humanoid and myRoot.Parent then humanoid.PlatformStand = false end
            return
        end

        angle = angle + (speed * deltaTime)
        local newPos = targetRoot.Position + Vector3.new(math.cos(angle) * radius, 2, math.sin(angle) * radius)
        myRoot.CFrame = CFrame.lookAt(newPos, targetRoot.Position)
    end)
end

local function fire_move(tool)
    if not remote or not tool then return end
    remote:FireServer({
        IsAutoActivate = true,
        Goal = "Console Move",
        Tool = tool,
        ToolName = tool.Name
    })
end

local function do_moves()
    local tools = get_moves()
    if #tools == 0 then return end
    
    for i = 1, 4 do
        if not comboRunning then break end
        m1()
        
        if not comboRunning then break end
        local toolIndex = ((i - 1) % #tools) + 1
        local currentTool = tools[toolIndex]
        
        task.wait(0.1)
        if not comboRunning then break end
        fire_move(currentTool)
        
        task.wait(0.1)
    end
end

local function start_combo_attack(targetName)
    if comboRunning then return end 
    
    local target = find_target(targetName)
    if not target then 
        warn("Target player not found!") 
        return 
    end
    
    comboRunning = true

    orbit(target, true, 3, 4)
    
    task.spawn(function()
        while comboRunning do
            do_moves()
            task.wait(0.2) 
        end
    end)
end

local function stop_combo_attack()
    comboRunning = false
    orbit(nil, false, 3, 3) 
end

start_combo_attack("JStarz101")
