local loadOk, WindUI = pcall(function()
    return loadstring(game:HttpGet(
        "https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"
    ))()
end)

if not loadOk then
    warn("WindUI failed to load:", WindUI)
    return
end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

local selectedTargetName = nil
local comboEnabled = false
local comboSession = 0

local orbitConnection = nil
local controlledHumanoid = nil
local oldPlatformStand = false
local angle = 0

local lastToolSignature = nil
local pauseUntil = 0

local ORBIT_RADIUS = 3
local ORBIT_HEIGHT = -6
local ORBIT_SPEED = 4
local FOLLOW_PREDICTION = 0.18
local MAX_FOLLOW_LEAD = 12

local TIME_BETWEEN_M1S = 0.18
local TIME_BETWEEN_TOOLS = 0.45
local TIME_BETWEEN_ROUNDS = 0.75
local PAUSE_CHECK_DELAY = 0.15
local G_PAUSE_DURATION = 0.5

local function getCharacter(targetPlayer)
    if not targetPlayer then
        return nil
    end

    return targetPlayer.Character
end

local function getHumanoid(targetPlayer)
    local character = getCharacter(targetPlayer)

    if not character then
        return nil
    end

    return character:FindFirstChildOfClass("Humanoid")
end

local function getRoot(targetPlayer)
    local character = getCharacter(targetPlayer)

    if not character then
        return nil
    end

    return character:FindFirstChild("HumanoidRootPart")
end

local function isAlive(targetPlayer)
    local humanoid = getHumanoid(targetPlayer)

    return humanoid ~= nil and humanoid.Health > 0
end

local function getRemote()
    local character = player.Character

    if not character then
        return nil
    end

    return character:FindFirstChild("Communicate")
end

local function getToolNames()
    local backpack = player:FindFirstChild("Backpack")
    local toolNames = {}

    if not backpack then
        return toolNames
    end

    -- Do not sort: the Backpack order is used for the fourth move.
    for _, item in ipairs(backpack:GetChildren()) do
        if item:IsA("Tool") then
            table.insert(toolNames, item.Name)
        end
    end

    return toolNames
end

local function getToolSignature(toolNames)
    return table.concat(toolNames, "\31")
end

local function findTool(toolName)
    local backpack = player:FindFirstChild("Backpack")
    local character = player.Character

    local tool = backpack and backpack:FindFirstChild(toolName)

    if not tool and character then
        tool = character:FindFirstChild(toolName)
    end

    if tool and tool:IsA("Tool") then
        return tool
    end

    return nil
end

local function containsTool(toolNames, targetName)
    for _, toolName in ipairs(toolNames) do
        if toolName == targetName then
            return true
        end
    end

    return false
end

local function isPaused()
    return os.clock() < pauseUntil
end

local function stopOrbit()
    if orbitConnection then
        orbitConnection:Disconnect()
        orbitConnection = nil
    end

    if controlledHumanoid and controlledHumanoid.Parent then
        controlledHumanoid.PlatformStand = oldPlatformStand
    end

    controlledHumanoid = nil
end

local function getSelectedTarget()
    if not selectedTargetName then
        return nil
    end

    return Players:FindFirstChild(selectedTargetName)
end

local function isSessionActive(session)
    return comboEnabled and comboSession == session
end

local function canAttack(session, target)
    return isSessionActive(session)
        and not isPaused()
        and target
        and isAlive(player)
        and isAlive(target)
end

local function startOrbit(target, session)
    if orbitConnection then
        return
    end

    local myHumanoid = getHumanoid(player)

    if myHumanoid then
        controlledHumanoid = myHumanoid
        oldPlatformStand = myHumanoid.PlatformStand
        myHumanoid.PlatformStand = true
    end

    orbitConnection = RunService.RenderStepped:Connect(function(deltaTime)
        if not canAttack(session, target) then
            stopOrbit()
            return
        end

        local targetRoot = getRoot(target)
        local myRoot = getRoot(player)

        if not targetRoot or not myRoot then
            stopOrbit()
            return
        end

        angle = angle + ORBIT_SPEED * deltaTime

        local velocity = targetRoot.AssemblyLinearVelocity
        local horizontalVelocity = Vector3.new(velocity.X, 0, velocity.Z)
        local lead = horizontalVelocity * FOLLOW_PREDICTION

        if lead.Magnitude > MAX_FOLLOW_LEAD then
            lead = lead.Unit * MAX_FOLLOW_LEAD
        end

        local predictedPosition = targetRoot.Position + lead

        local orbitPosition = predictedPosition + Vector3.new(
            math.cos(angle) * ORBIT_RADIUS,
            ORBIT_HEIGHT,
            math.sin(angle) * ORBIT_RADIUS
        )

        myRoot.CFrame = CFrame.lookAt(orbitPosition, predictedPosition)
    end)
end

local function doM1(session, target)
    for _ = 1, 3 do
        if not canAttack(session, target) then
            return false
        end

        local remote = getRemote()

        if not remote then
            return false
        end

        remote:FireServer({
            Mobile = true,
            Goal = "LeftClick",
        })

        remote:FireServer({
            Mobile = true,
            Goal = "LeftClickRelease",
        })

        task.wait(TIME_BETWEEN_M1S)
    end

    return true
end

local function fireMove(toolName, session, target)
    if not canAttack(session, target) then
        return false
    end

    local remote = getRemote()
    local tool = findTool(toolName)

    if not remote or not tool then
        return false
    end

    remote:FireServer({
        IsAutoActivate = true,
        Goal = "Console Move",
        Tool = tool,
        ToolName = toolName,
    })

    return true
end

local function doComboRound(session, target)
    local toolNames = getToolNames()
    local toolCount = math.min(#toolNames, 4)

    for index = 1, toolCount do
        if not doM1(session, target) then
            return
        end

        if not fireMove(toolNames[index], session, target) then
            return
        end

        if index < toolCount then
            task.wait(TIME_BETWEEN_TOOLS)
        end
    end
end

local function pressG()
    local remote = getRemote()

    if not remote then
        warn("Communicate remote was not found.")
        return
    end

    -- Snapshot current moves before the ultimate changes their names.
    lastToolSignature = getToolSignature(getToolNames())

    -- Pause both attacks and orbit movement for 0.5 seconds.
    pauseUntil = os.clock() + G_PAUSE_DURATION
    stopOrbit()

    remote:FireServer({
        Key = Enum.KeyCode.G,
        MoveDirection = Vector3.new(0, 0, 0),
        Goal = "KeyPress",
        MousePos = CFrame.new(
            -138.00552368164,
            437.50628662109,
            78.483154296875,
            0.18005938827991,
            0.15804965794086,
            -0.9708753824234,
            0,
            0.98700731992722,
            0.16067577898502,
            0.98365581035614,
            -0.028931181877851,
            0.17771992087364
        ),
    })

    remote:FireServer({
        Goal = "KeyRelease",
        Key = Enum.KeyCode.G,
    })
end

local function handleMoveNameChange(session, target, toolNames)
    if containsTool(toolNames, "Death Counter") then
        -- Saitama: use the fourth Backpack move after the ultimate changes moves.
        local fourthMove = toolNames[4]

        if fourthMove then
            fireMove(fourthMove, session, target)
        end
    else
        -- Other characters: one normal M1 sequence, then resume the normal loop.
        doM1(session, target)
    end
end

local function checkForMoveNameChange(session, target)
    local toolNames = getToolNames()
    local signature = getToolSignature(toolNames)

    if not lastToolSignature then
        lastToolSignature = signature
        return
    end

    if signature == lastToolSignature then
        return
    end

    lastToolSignature = signature
    handleMoveNameChange(session, target, toolNames)
end

local function stopCombo()
    comboEnabled = false
    comboSession = comboSession + 1
    stopOrbit()
end

local function startCombo()
    local target = getSelectedTarget()

    if not target or target == player then
        warn("Select a valid target first.")
        return
    end

    comboEnabled = true
    comboSession = comboSession + 1

    local session = comboSession
    lastToolSignature = getToolSignature(getToolNames())

    task.spawn(function()
        while isSessionActive(session) do
            target = getSelectedTarget()

            if isPaused() then
                stopOrbit()
                task.wait(PAUSE_CHECK_DELAY)
            elseif target and isAlive(player) and isAlive(target) then
                startOrbit(target, session)
                checkForMoveNameChange(session, target)

                if canAttack(session, target) then
                    doComboRound(session, target)
                end

                task.wait(TIME_BETWEEN_ROUNDS)
            else
                -- A death pauses the script but does not switch the UI toggle off.
                stopOrbit()
                task.wait(PAUSE_CHECK_DELAY)
            end
        end

        stopOrbit()
    end)
end

local function getPlayerNames()
    local names = {}

    for _, otherPlayer in ipairs(Players:GetPlayers()) do
        if otherPlayer ~= player then
            table.insert(names, otherPlayer.Name)
        end
    end

    table.sort(names)

    return names
end

local Window = WindUI:CreateWindow({
    Title = "Combat Test",
    Icon = "crosshair",
    Size = UDim2.fromOffset(420, 280),
    MinSize = Vector2.new(420, 280),
    Theme = "Dark",
    Transparent = true,
    Resizable = false,
    ToggleKey = Enum.KeyCode.RightShift,
})

local Tab = Window:Tab({
    Title = "Target",
    Icon = "crosshair",
})

local playerNames = getPlayerNames()
selectedTargetName = playerNames[1]

local targetDropdown = Tab:Dropdown({
    Title = "Target player",
    Values = playerNames,
    Value = selectedTargetName,
    Multi = false,
    AllowNone = true,
    Callback = function(playerName)
        selectedTargetName = playerName

        if comboEnabled then
            startCombo()
        end
    end,
})

Tab:Button({
    Title = "Refresh players",
    Callback = function()
        local names = getPlayerNames()

        targetDropdown:Refresh(names)

        if selectedTargetName and Players:FindFirstChild(selectedTargetName) then
            targetDropdown:Select(selectedTargetName)
        else
            selectedTargetName = names[1]

            if selectedTargetName then
                targetDropdown:Select(selectedTargetName)
            end
        end
    end,
})

Tab:Button({
    Title = "Activate G",
    Callback = function()
        pressG()
    end,
})

Tab:Toggle({
    Title = "Combo attack",
    Value = false,
    Callback = function(enabled)
        if enabled then
            startCombo()
        else
            stopCombo()
        end
    end,
})

-- Persistent Open UI button: survives minimising and local-character respawns.
local reopenGui = Instance.new("ScreenGui")
reopenGui.Name = "CombatTestReopen"
reopenGui.ResetOnSpawn = false
reopenGui.IgnoreGuiInset = true
reopenGui.Parent = player:WaitForChild("PlayerGui")

local reopenButton = Instance.new("TextButton")
reopenButton.Name = "OpenButton"
reopenButton.AnchorPoint = Vector2.new(1, 0)
reopenButton.Position = UDim2.new(1, -16, 0, 72)
reopenButton.Size = UDim2.fromOffset(105, 34)
reopenButton.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
reopenButton.BorderSizePixel = 0
reopenButton.Text = "Open UI"
reopenButton.TextColor3 = Color3.fromRGB(255, 255, 255)
reopenButton.TextSize = 14
reopenButton.Font = Enum.Font.GothamMedium
reopenButton.Parent = reopenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 7)
corner.Parent = reopenButton

reopenButton.Activated:Connect(function()
    if type(Window.Open) == "function" then
        Window:Open()
    elseif type(Window.Toggle) == "function" then
        Window:Toggle()
    end
end)

Players.PlayerRemoving:Connect(function(leavingPlayer)
    if leavingPlayer.Name == selectedTargetName then
        selectedTargetName = nil
        stopOrbit()
    end
end)

Tab:Select()
